# Raw source datasets (11GB, provided locally - not project source)
Datasets/

# Generated data/models/reports - all reproducible via scripts/ (see README)
outputs/

# Python virtual environment
.venv/
venv/

# Python build/cache artifacts
__pycache__/
*.pyc
*.egg-info/
/build/
/dist/

# Pretrained weights auto-downloaded by ultralytics (re-fetched on demand),
# and any stray checkpoints elsewhere - but the shipped inference weights in
# models/ are tracked so the apps work right after a git pull, no training
# required.
*.pt
*.onnx
!models/**/*.pt

# Stray Ultralytics run dir created if project/name resolution misbehaves
/runs/

# Frontend (web/frontend) - dist/ is tracked (see below) so the FastAPI
# backend can serve the app right after a git pull, no npm/node needed
node_modules/
*.local

# OS cruft
.DS_Store
Thumbs.db

docs